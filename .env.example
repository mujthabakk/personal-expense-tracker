# Copy to .env.local and fill in from Firebase console → Project settings.
# The web API key is public in the client. Access is enforced by Firestore rules
# and Firebase Authentication, not by hiding this key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
